// nn.clic — transformer building blocks: row-wise softmax and layernorm.
//
// These two ops appear in every LLM: softmax turns attention scores into
// probabilities; layernorm stabilizes activations. Both are row-wise reductions
// (max/sum for softmax; mean/variance for layernorm). One thread per row keeps
// them simple and correct; they're verified against a CPU reference.

kernel softmax_rows(R: i32, C: i32, x: buffer<f32>, y: buffer<f32>) {
    let r = tid.x;
    if (r < R) {
        var m = x[r * C];                                   // row max (stability)
        for (var j: i32 = 1; j < C; j = j + 1) { m = max(m, x[r * C + j]); }
        var s = 0.0;                                        // sum of exp
        for (var j: i32 = 0; j < C; j = j + 1) { s = s + exp(x[r * C + j] - m); }
        for (var j: i32 = 0; j < C; j = j + 1) {
            y[r * C + j] = exp(x[r * C + j] - m) / s;
        }
    }
}

kernel layernorm_rows(R: i32, C: i32, eps: f32, x: buffer<f32>, y: buffer<f32>) {
    let r = tid.x;
    if (r < R) {
        var mean = 0.0;
        for (var j: i32 = 0; j < C; j = j + 1) { mean = mean + x[r * C + j]; }
        mean = mean / float(C);
        var v = 0.0;
        for (var j: i32 = 0; j < C; j = j + 1) {
            let d = x[r * C + j] - mean;
            v = v + d * d;
        }
        v = v / float(C);
        let inv = 1.0 / sqrt(v + eps);
        for (var j: i32 = 0; j < C; j = j + 1) {
            y[r * C + j] = (x[r * C + j] - mean) * inv;
        }
    }
}
