// linear.clic — a dense/linear layer without activation:  C = A*B + bias
// The output layer of an MLP (pairs with linear_relu for hidden layers).

kernel linear(M: i32, N: i32, K: i32,
              A: buffer<f32>, B: buffer<f32>, bias: buffer<f32>, C: buffer<f32>) {
    let row = tid.y;
    let col = tid.x;
    if (row < M && col < N) {
        var acc: f32 = bias[col];
        for (var k: i32 = 0; k < K; k = k + 1) {
            acc = acc + A[row * K + k] * B[k * N + col];
        }
        C[row * N + col] = acc;
    }
}
