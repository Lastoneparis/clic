// keccak.clic — the Keccak-f[1600] permutation, the core of SHA-3 / keccak256.
//
// The permutation now lives in a reusable module (lib/keccak.clic); this file
// just runs it on the all-zero state and writes the 25 lanes out. The host
// checks every lane against an independent CPU reference AND against the
// published zero-state Known-Answer Test (lane 0 must be 0xF1258F7940E1DDE7).

include "../lib/keccak.clic"

kernel keccak(out: buffer<u32>) {
    var A: array<u64, 25>;
    for (var i: i32 = 0; i < 25; i = i + 1) { A[i] = ulong(0); }

    keccakf(A);          // permute the zero state in place

    for (var i: i32 = 0; i < 25; i = i + 1) {
        out[i * 2 + 0] = uint(A[i]);
        out[i * 2 + 1] = uint(A[i] >> 32);
    }
}
